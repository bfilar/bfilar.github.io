---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Timeline from "../../components/ui/Timeline.astro";
import { PAGES } from "../../config";

if (PAGES.cv.isActive === false) {
    return Astro.redirect("/404");
}

const cvEntry = await getEntry("cv", "cv");
if (!cvEntry) {
    throw new Error(
        "CV content not found. Please ensure src/content/cv.md exists.",
    );
}

const { Content } = await render(cvEntry);
const { name, title, location, experience = [], education = [], patents = [] } = cvEntry.data;
---

<BaseLayout title={PAGES.cv.title}>
    <header class="page-header">
        <h1 class="page-title">{PAGES.cv.title}</h1>
        {location && <p class="page-subtitle">{location}</p>}
    </header>

    <div class="container-narrow">
        {
            experience.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        Experience
                    </h2>
                    <Timeline items={experience.map(exp => ({
                        title: exp.role,
                        subtitle: exp.institution,
                        period: exp.period,
                        description: exp.description
                    }))} />
                </section>
            )
        }

        {
            patents.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        Patents
                    </h2>
                    <ul class="body list-disc pl-5 space-y-2">
                        {patents.map(p => (
                            <li>
                                {p.title}
                                {p.number && <span class="opacity-75"> ({p.number})</span>}
                                <span class="opacity-75"> — {p.year}</span>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            education.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        Education
                    </h2>
                    <Timeline items={education.map(edu => ({
                        title: edu.degree,
                        subtitle: edu.institution,
                        period: edu.period,
                        description: edu.description,
                        thesis: edu.thesis
                    }))} />
                </section>
            )
        }

        <div class="prose max-w-none">
            <Content />
        </div>
    </div>
</BaseLayout>
